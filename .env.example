# Base de données (PostgreSQL — ex: Supabase)
# DATABASE_URL : connexion "pooled" (port 6543, ?pgbouncer=true) — utilisée à l'exécution (serverless-friendly)
# DIRECT_URL   : connexion directe (port 5432) — utilisée uniquement par les migrations
DATABASE_URL="postgresql://user:password@aws-0-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@db.xxx.supabase.co:5432/postgres"

# NextAuth
# Génère une valeur avec: npx auth secret
AUTH_SECRET="remplace-moi-par-une-valeur-generee"
AUTH_URL="http://localhost:3000"

# --- Paiements Tunisie (à connecter dans une prochaine étape) ---
# Ne jamais committer de vraies clés. Laisser vide tant que non configuré.
D17_API_KEY=
D17_MERCHANT_ID=
FLOUCI_API_KEY=
FLOUCI_APP_SECRET=
IZI_API_KEY=
